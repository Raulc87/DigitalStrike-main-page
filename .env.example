# Build-time variables of the static site (contract §8). Copy to `.env` for local work.
# They are public by design: never put a secret here. In GitHub they are repository *variables*.

# Lead endpoint. Locally and in CI: the mock (`npm run mock:lead`). Production: the Apps Script
# /exec URL, set only as a GitHub repository variable.
PUBLIC_LEAD_ENDPOINT_URL=http://127.0.0.1:8787/exec

PUBLIC_CALENDLY_URL=https://calendly.com/rcasanas/1hr
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/raul-casanas/
# Contact address shown on the site; empty uses the code default (BR-009).
PUBLIC_CONTACT_EMAIL=

# https://digitalstrike-solutions.com in production; https://raulc87.github.io for the Pages preview.
PUBLIC_SITE_URL=http://localhost:4321
# "/" for the own domain and local work; "/DigitalStrike-main-page" for the Pages preview.
PUBLIC_BASE_PATH=/

# Version shown in the privacy notice and sent with each lead; must be listed in the Apps Script
# property ACCEPTED_PRIVACY_NOTICE_VERSIONS before a site showing it is deployed.
PUBLIC_PRIVACY_NOTICE_VERSION=2026-10-14-v1

PUBLIC_SHOW_CLIENT_LOGOS=true
# true in preview builds, false in production.
PUBLIC_SHOW_PENDING_BADGES=false
# true only in the Pages preview build (adds noindex), false or unset in production.
PUBLIC_NOINDEX=false
