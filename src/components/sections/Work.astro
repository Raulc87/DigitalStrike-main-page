---
import { t } from '../../i18n';
import type { ContentKey, Locale } from '../../i18n';
import { withBase } from '../../lib/i18n/url';
import PendingBadge from './PendingBadge.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Screenshots: drop a 1200×750 `public/images/work/<id>.jpg` (gaby, cami, poliart) and the card shows
// it; without the file the card header shows the project initials (CONTENT §7, provisional).
// `repo`: null = private case study, no link.
const available = new Set(Object.keys(import.meta.glob('/public/images/work/*.jpg')));
const shot = (id: string) =>
  available.has(`/public/images/work/${id}.jpg`) ? `images/work/${id}.jpg` : null;
const projects = [
  {
    n: 1,
    initials: 'GM',
    repo: 'https://github.com/Raulc87/gaby-main-page',
    screenshot: shot('gaby'),
  },
  {
    n: 2,
    initials: 'CM',
    repo: 'https://github.com/Raulc87/cami-main-page',
    screenshot: shot('cami'),
  },
  { n: 3, initials: 'PI', repo: null, screenshot: shot('poliart') },
] as const;
const key = (n: number, part: string) => `work.${n}.${part}` as ContentKey;
---

<section id="proyectos">
  <div class="section-shell py-16 md:py-20">
    <h2>{t(lang, 'work.title')}</h2>
    <p class="text-text-2 mt-4 max-w-3xl">{t(lang, 'work.intro')}</p>

    <ul class="mt-10 grid list-none gap-6 p-0 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <li
          data-project-card
          class="bg-card border-border hover:border-cyan flex flex-col overflow-hidden rounded-xl border transition-colors"
        >
          <div class="bg-steel relative flex aspect-[16/10] items-center justify-center">
            {project.screenshot ? (
              <img
                src={withBase(project.screenshot)}
                alt=""
                width="1200"
                height="750"
                loading="lazy"
                class="size-full object-cover"
              />
            ) : (
              <span
                data-initials
                class="text-cyan font-mono text-5xl font-medium tracking-widest"
                aria-hidden="true"
              >
                {project.initials}
              </span>
            )}
            {!project.screenshot && <PendingBadge lang={lang} class="absolute top-3 left-3" />}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-xl font-bold">{t(lang, key(project.n, 'title'))}</h3>
            <p class="text-text-2 mt-3">{t(lang, key(project.n, 'body'))}</p>
            <ul class="my-5 flex list-none flex-wrap gap-2 p-0">
              {t(lang, key(project.n, 'tags'))
                .split(' · ')
                .map((tag) => (
                  <li class="bg-grid text-text-2 rounded-md px-2.5 py-1 font-mono text-xs">
                    {tag}
                  </li>
                ))}
            </ul>
            {project.repo ? (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener"
                class="text-cyan mt-auto inline-flex min-h-11 items-center font-semibold underline-offset-4 hover:underline"
              >
                {t(lang, 'work.repo_link')}
              </a>
            ) : (
              <p class="text-text-2 mt-auto inline-flex min-h-11 items-center font-mono text-sm">
                {t(lang, 'work.private')}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
