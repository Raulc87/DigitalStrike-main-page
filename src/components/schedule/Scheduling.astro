---
// Scheduling (US-013, FR-016, UX §3). Click-to-load: a preview card until the visitor clicks
// "Ver horarios disponibles" or submits the lead form; then the official Calendly inline widget.
import type { Locale } from '../../i18n';
import { formT } from '../../lib/lead/messages';
import { routes } from '../../lib/i18n/routes';
import { withBase } from '../../lib/i18n/url';
import { calendlyUrl } from '../../lib/schedule/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const fallbackLink = 'inline-flex min-h-11 items-center underline underline-offset-4';

// The words "aviso de privacidad" / "privacy notice" inside the CONTENT §11 notice become a link
// that opens the privacy dialog (owner decision 2026-10-11); the sentence itself is unchanged.
const privacyWords = { es: 'aviso de privacidad', en: 'privacy notice' } as const;
const notice = formT(lang, 'schedule.notice');
const at = notice.indexOf(privacyWords[lang]);
const noticeBefore = at < 0 ? notice : notice.slice(0, at);
const noticeLink = at < 0 ? '' : privacyWords[lang];
const noticeAfter = at < 0 ? '' : notice.slice(at + noticeLink.length);
---

<section id="agenda" class="bg-steel" data-lang={lang}>
  <div class="section-shell py-16">
    <h2 id="agenda-title" class="text-off" tabindex="-1" data-schedule-title>
      {formT(lang, 'schedule.title')}
    </h2>
    <p class="text-text-2 mt-4 max-w-2xl">{formT(lang, 'schedule.body')}</p>

    <div class="mt-8" data-schedule-root data-calendly-url={calendlyUrl}>
      <div
        data-schedule-preview
        class="border-border-strong flex min-h-[1000px] flex-col items-center justify-center gap-5 rounded-xl border-2 border-dashed p-6 text-center md:min-h-[700px]"
      >
        <button
          type="button"
          data-schedule-open
          class="bg-cyan text-navy inline-flex min-h-12 items-center justify-center rounded-full px-8 font-semibold hover:brightness-110"
        >
          {formT(lang, 'schedule.open')}
        </button>
        <!-- prettier-ignore -->
        <p class="text-text-2 max-w-md text-sm" data-schedule-notice>{noticeBefore}{noticeLink && <a href={withBase(routes.privacy[lang])} target="_blank" rel="noopener" data-privacy-open class="underline underline-offset-4">{noticeLink}</a>}{noticeAfter}</p>
        <noscript>
          <a href={calendlyUrl} target="_blank" rel="noopener" class={fallbackLink}>
            {formT(lang, 'schedule.fallback')}
          </a>
        </noscript>
      </div>

      <div data-schedule-widget hidden>
        <p data-schedule-loading class="text-text-2" role="status">
          {formT(lang, 'schedule.loading')}
        </p>
        <!-- widget.js renders its iframe at height 100%: the container needs a definite height. -->
        <div data-schedule-container class="h-[1000px] md:h-[700px]"></div>
        <p data-schedule-fallback class="mt-4" hidden>
          <a href={calendlyUrl} target="_blank" rel="noopener" class={fallbackLink}>
            {formT(lang, 'schedule.fallback')}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { LEAD_SUBMITTED_EVENT } from '../../lib/lead/events';
  import type { LeadSubmittedDetail } from '../../lib/lead/events';
  import { createCalendlyEmbed } from '../../lib/schedule/calendly';

  const root = document.querySelector<HTMLElement>('[data-schedule-root]');
  const get = (name: string) => root?.querySelector<HTMLElement>(`[data-schedule-${name}]`);
  const preview = get('preview');
  const widget = get('widget');
  const container = get('container');
  const loading = get('loading');
  const fallback = get('fallback');
  const button = get('open');
  const title = document.querySelector<HTMLElement>('[data-schedule-title]');

  if (root && preview && widget && container && loading && fallback && button) {
    const embed = createCalendlyEmbed(root.dataset.calendlyUrl ?? '', {
      preview,
      widget,
      container,
      loading,
      fallback,
    });
    button.addEventListener('click', () => {
      void embed.open();
      title?.focus(); // the button is gone; keep focus in the section, on its heading
    });
    // After a successful lead: (re)initialize with name and email prefilled (US-013 AC2).
    window.addEventListener(LEAD_SUBMITTED_EVENT, (event) => {
      const { name, email } = (event as CustomEvent<LeadSubmittedDetail>).detail;
      void embed.open({ name, email });
    });
  }
</script>
