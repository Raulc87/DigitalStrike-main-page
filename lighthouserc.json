{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/es/index.html", "/en/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "server-response-time": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "mainthread-work-breakdown": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "dom-size": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "render-blocking-resources": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "render-blocking-insight": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "font-display": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "uses-text-compression": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "network-dependency-tree-insight": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "unused-css-rules": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "image-delivery-insight": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "lcp-discovery-insight": [
          "warn",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
