---
import type { Locale } from '../../i18n';
import { withBase } from '../../lib/i18n/url';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<!-- Scaffold header (US-001 AC5): logo mark + live wordmark. US-003 adds nav, toggle and CTA. -->
<header class="border-border bg-navy/90 sticky top-0 z-50 border-b backdrop-blur" data-lang={lang}>
  <div class="section-shell flex min-h-16 items-center">
    <a href={withBase(`${lang}/`)} class="text-off flex items-center gap-3 no-underline">
      <img src={withBase('brand/logo-mark-on-dark.svg')} alt="" width="44" height="44" />
      <span class="text-xl font-extrabold">
        DigitalStrike<span class="text-cyan max-[420px]:hidden">&nbsp;Solutions</span>
      </span>
    </a>
  </div>
</header>
