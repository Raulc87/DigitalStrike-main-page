---
import { t } from '../../i18n';
import type { Locale } from '../../i18n';
import { routes } from '../../lib/i18n/routes';
import type { RouteName } from '../../lib/i18n/routes';
import { LOCALES, withBase } from '../../lib/i18n/url';

interface Props {
  lang: Locale;
  route: RouteName;
}

const { lang, route } = Astro.props;
---

<nav aria-label={t(lang, 'lang.toggle_label')} class="flex items-center" data-lang-toggle>
  {LOCALES.map((locale, index) => (
    <>
      {index > 0 && (
        <span aria-hidden="true" class="text-border-strong max-[380px]:hidden">
          |
        </span>
      )}
      <a
        href={withBase(routes[route][locale])}
        hreflang={locale}
        lang={locale}
        aria-current={locale === lang ? 'true' : undefined}
        class:list={[
          'text-off flex min-h-11 min-w-11 items-center justify-center rounded-full px-2 font-mono text-sm no-underline hover:text-cyan',
          locale === lang ? 'font-bold' : 'text-text-2 font-normal',
        ]}
      >
        {locale.toUpperCase()}
      </a>
    </>
  ))}
</nav>

<script>
  import { saveLanguage } from '../../lib/i18n/detect';
  import type { Locale } from '../../lib/i18n/url';

  // Keep the visitor on the same section: the anchors are shared by both pages (ADR-003).
  // The choice is saved before navigating; storage failures are ignored.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle] a[hreflang]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.getAttribute('hreflang');
      if (target === 'es' || target === 'en') {
        try {
          saveLanguage(target as Locale, window.localStorage);
        } catch {
          // storage blocked
        }
      }
      // Same section on the other page. Keep the URL hash while its section is still on screen;
      // otherwise use the section the visitor has scrolled to (the last one whose top has passed
      // the sticky header; the hero maps to the plain page). Sections come from the DOM, so a new
      // section needs no change here.
      const hashed = location.hash ? document.querySelector(location.hash) : null;
      const onScreen = (el: Element) => {
        const rect = el.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 0;
      };
      if (hashed && onScreen(hashed)) {
        link.hash = location.hash;
      } else {
        const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
        const current = sections.filter((el) => el.getBoundingClientRect().top <= 96).pop();
        if (current && current.id !== 'inicio') link.hash = current.id;
      }
    });
  });
</script>
